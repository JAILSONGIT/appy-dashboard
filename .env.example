# Copie este arquivo para .env e ajuste os dados de acesso.
# MySQL instalado no próprio Windows:
DATABASE_URL=mysql+pymysql://appy_user:SENHA_DO_USUARIO@127.0.0.1:3306/appy_db
# Gere uma chave longa e aleatória para uso local/institucional.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
PORT=5000
# Use 1 apenas para depuração local; mantenha 0 em uso normal.
FLASK_DEBUG=0

# Credenciais de acesso ao dashboard
APPY_ADMIN_USER=admin
APPY_ADMIN_PASSWORD=troque-por-uma-senha-forte
# Em HTTPS na hospedagem, use 1 para cookie seguro; local HTTP use 0
COOKIE_SECURE=0
